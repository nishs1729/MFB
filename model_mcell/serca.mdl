serca_number_presynaptic=serca_conc_tot*presynaptic_vol/(1e15/6.02205e23)

// rates for SERCA Ca Pumps 
// From Higgins et al, 2006, Biophys. J. 
// Corrected rates that account for K1^2 = Keff^2.  See serca_ode.py 
// Also typo for k-2 in Higgins et al. 2006.  k-2 should be 0.097 not 0.97 
// Parameters are modified to make ER Ca conc saturate at around 250uM in about 10-15 sec 
f = 18
k_SERCA_X1A_X2 = 1.0e8
k_SERCA_X1_X1A = 2*k_SERCA_X1A_X2
k_SERCA_X1A_X1 = 83.666
k_SERCA_X2_X1A = 2*k_SERCA_X1A_X1
k_SERCA_X2_Y2  = f*0.6
k_SERCA_Y2_X2  = f*43*0.097
k_SERCA_Y1A_Y1 = 30.015
k_SERCA_Y2_Y1A = 2*k_SERCA_Y1A_Y1
k_SERCA_Y1A_Y2 = 1.0e5
k_SERCA_Y1_Y1A = 2*k_SERCA_Y1A_Y2
k_SERCA_Y1_X1  = f*0.4
k_SERCA_X1_Y1  = f*1.2e-3


DEFINE_MOLECULES {

    SERCA_X0 {DIFFUSION_CONSTANT_2D = 0}
    SERCA_X1 {DIFFUSION_CONSTANT_2D = 0}
    SERCA_X2 {DIFFUSION_CONSTANT_2D = 0}
    SERCA_Y0 {DIFFUSION_CONSTANT_2D = 0}
    SERCA_Y1 {DIFFUSION_CONSTANT_2D = 0}
    SERCA_Y2 {DIFFUSION_CONSTANT_2D = 0}

}

DEFINE_REACTIONS {
    // 6-step Buffering SERCA Pump
    // From Higgins et al, 2006, Biophys. J.
    // Note: includes Cae in the ER
    Ca' + SERCA_X0' <-> SERCA_X1'        [>k_SERCA_X0_X1, <k_SERCA_X1_X0]
    Ca' + SERCA_X1' <-> SERCA_X2'        [>k_SERCA_X1_X2, <k_SERCA_X2_X1]
    SERCA_X2'        -> SERCA_Y2'        [k_SERCA_X2_Y2] : serca_x2_y2
    SERCA_Y2'        -> SERCA_X2'        [k_SERCA_Y2_X2] : serca_y2_x2
    SERCA_Y2'       <-> Cae, + SERCA_Y1' [>k_SERCA_Y2_Y1, <k_SERCA_Y1_Y2]
    SERCA_Y1'       <-> Cae, + SERCA_Y0' [>k_SERCA_Y1_Y0, <k_SERCA_Y0_Y1]
    SERCA_Y1'       <-> SERCA_X1'        [>k_SERCA_Y1_X1, <k_SERCA_X1_Y1]
}
