//------- Calbindin Rates and Parameters ----------

D_cb = 0 //0.28e-6 // Schmidt et al. 2003, J. Physiol.
cb_conc = 40e-6  // since medium and high are modelled as separate mols

// CalB reaction rates
cbH_on  = 0.55e7
cbH_off = 2.6
cbM_on  = 4.35e7
cbM_off = 35.8

// Calbindin eq fractions at [cbH0M0]o = 40 uM and [Ca2]i = ~100 nm
cbM0_feq = 0.794640
cbM1_feq = 0.193611
cbM2_feq = 0.011749
cbH0_feq = 0.681430
cbH1_feq = 0.288101
cbH2_feq = 0.030469

