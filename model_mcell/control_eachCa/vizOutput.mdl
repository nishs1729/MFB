ISI = ISI*1e3
VIZ_OUTPUT
{
	MODE = ASCII
	FILENAME = outputDir &"/viz/mfb"
	MOLECULES
	{
//		NAME_LIST {"Ca*" "cb*M1" "cb*M2" "cb*H1" "cb*H2"}
//		NAME_LIST {"Ca*" "cb*"}
        NAME_LIST {"Ca*"}
		ITERATION_NUMBERS {POSITIONS @ [[ISI*0 TO 4000+ISI*0 STEP 50], 
		                                [ISI*1 TO 4000+ISI*1 STEP 50],
		                                [ISI*2 TO 4000+ISI*2 STEP 50],
		                                [ISI*3 TO 4000+ISI*3 STEP 50],
		                                [ISI*4 TO 4000+ISI*4 STEP 50],
		                                [ISI*5 TO 4000+ISI*5 STEP 50],
		                                [ISI*6 TO 4000+ISI*6 STEP 50],
		                                [ISI*7 TO 4000+ISI*7 STEP 50],
		                                [ISI*8 TO 4000+ISI*8 STEP 50],
		                                [ISI*9 TO 4000+ISI*9 STEP 50]]}
	}
}
