PMCA_density_presynaptic = 180

// rates for PMCA pump
// According to Sneyd et al, 2003, Biophys. J.
//Vmax for PMCA channels is 28 uM/s.
//At 10/s per channel we'll need 1900 channels or 180 per um^2
/*
k_PMCA0_1 = 1.5e8
k_PMCA1_0 = 20
k_PMCA1_2 = 10
k_PMCA2_0 = 1e5
k_PMCA0_leak = 5
*/

// But that's too slow so let's increase the density to 1000 um^2
// and the pump rate to 100/s
k_PMCA0_1 = 1.5e8
k_PMCA1_0 = 20
k_PMCA1_2 = 100
k_PMCA2_0 = 1e5

// Calculate leak rate needed to achieve desired [Ca]i
cai = ca_conc_presynaptic
Km = (k_PMCA1_0+k_PMCA1_2)/k_PMCA0_1
E0 = 1e15*(PMCA_density_presynaptic*presynaptic_area/presynaptic_vol)/6.02205e23
ES = (E0*cai)/(Km+cai)
E = E0-ES
Vmax = k_PMCA1_2*E0
V = (Vmax*cai)/(Km+cai)
pmca_pump_rate = V/E

/* leak rate calculated above from [Ca]i given by ca_conc_base_presynaptic */
k_PMCA0_leak = pmca_pump_rate


DEFINE_MOLECULES {

    PMCA0 {D_2D = 0}
    PMCA1 {D_2D = 0}
    PMCA2 {D_2D = 0}

}

DEFINE_REACTIONS {

    // PMCA pump with built-in leak
    Ca0, + PMCA0' <-> PMCA1'      [>k_PMCA0_1, <k_PMCA1_0]
    PMCA1'       -> PMCA2'        [k_PMCA1_2]
    PMCA2'       -> PMCA0'        [k_PMCA2_0]
    PMCA0'       -> PMCA0' + Ca0, [k_PMCA0_leak]

    Ca1, + PMCA0' <-> PMCA1'      [>k_PMCA0_1, <k_PMCA1_0]
    PMCA0'       -> PMCA0' + Ca1, [k_PMCA0_leak]

    Ca2, + PMCA0' <-> PMCA1'      [>k_PMCA0_1, <k_PMCA1_0]
    PMCA0'       -> PMCA0' + Ca2, [k_PMCA0_leak]

    Ca3, + PMCA0' <-> PMCA1'      [>k_PMCA0_1, <k_PMCA1_0]
    PMCA0'       -> PMCA0' + Ca3, [k_PMCA0_leak]

    Ca4, + PMCA0' <-> PMCA1'      [>k_PMCA0_1, <k_PMCA1_0]
    PMCA0'       -> PMCA0' + Ca4, [k_PMCA0_leak]

    Ca5, + PMCA0' <-> PMCA1'      [>k_PMCA0_1, <k_PMCA1_0]
    PMCA0'       -> PMCA0' + Ca5, [k_PMCA0_leak]

    Ca6, + PMCA0' <-> PMCA1'      [>k_PMCA0_1, <k_PMCA1_0]
    PMCA0'       -> PMCA0' + Ca6, [k_PMCA0_leak]

    Ca7, + PMCA0' <-> PMCA1'      [>k_PMCA0_1, <k_PMCA1_0]
    PMCA0'       -> PMCA0' + Ca7, [k_PMCA0_leak]

    Ca8, + PMCA0' <-> PMCA1'      [>k_PMCA0_1, <k_PMCA1_0]
    PMCA0'       -> PMCA0' + Ca8, [k_PMCA0_leak]

    Ca9, + PMCA0' <-> PMCA1'      [>k_PMCA0_1, <k_PMCA1_0]
    PMCA0'       -> PMCA0' + Ca9, [k_PMCA0_leak]

    Ca10, + PMCA0' <-> PMCA1'      [>k_PMCA0_1, <k_PMCA1_0]
    PMCA0'       -> PMCA0' + Ca10, [k_PMCA0_leak]

    Ca11, + PMCA0' <-> PMCA1'      [>k_PMCA0_1, <k_PMCA1_0]
    PMCA0'       -> PMCA0' + Ca11, [k_PMCA0_leak]

    Ca12, + PMCA0' <-> PMCA1'      [>k_PMCA0_1, <k_PMCA1_0]
    PMCA0'       -> PMCA0' + Ca12, [k_PMCA0_leak]

    Ca13, + PMCA0' <-> PMCA1'      [>k_PMCA0_1, <k_PMCA1_0]
    PMCA0'       -> PMCA0' + Ca13, [k_PMCA0_leak]

    Ca14, + PMCA0' <-> PMCA1'      [>k_PMCA0_1, <k_PMCA1_0]
    PMCA0'       -> PMCA0' + Ca14, [k_PMCA0_leak]

    Ca15, + PMCA0' <-> PMCA1'      [>k_PMCA0_1, <k_PMCA1_0]
    PMCA0'       -> PMCA0' + Ca15, [k_PMCA0_leak]

    Ca16, + PMCA0' <-> PMCA1'      [>k_PMCA0_1, <k_PMCA1_0]
    PMCA0'       -> PMCA0' + Ca16, [k_PMCA0_leak]

    Ca17, + PMCA0' <-> PMCA1'      [>k_PMCA0_1, <k_PMCA1_0]
    PMCA0'       -> PMCA0' + Ca17, [k_PMCA0_leak]

    Ca18, + PMCA0' <-> PMCA1'      [>k_PMCA0_1, <k_PMCA1_0]
    PMCA0'       -> PMCA0' + Ca18, [k_PMCA0_leak]

    Ca19, + PMCA0' <-> PMCA1'      [>k_PMCA0_1, <k_PMCA1_0]
    PMCA0'       -> PMCA0' + Ca19, [k_PMCA0_leak]

    Ca20, + PMCA0' <-> PMCA1'      [>k_PMCA0_1, <k_PMCA1_0]
    PMCA0'       -> PMCA0' + Ca20, [k_PMCA0_leak]

    Ca21, + PMCA0' <-> PMCA1'      [>k_PMCA0_1, <k_PMCA1_0]
    PMCA0'       -> PMCA0' + Ca21, [k_PMCA0_leak]

    Ca22, + PMCA0' <-> PMCA1'      [>k_PMCA0_1, <k_PMCA1_0]
    PMCA0'       -> PMCA0' + Ca22, [k_PMCA0_leak]

    Ca23, + PMCA0' <-> PMCA1'      [>k_PMCA0_1, <k_PMCA1_0]
    PMCA0'       -> PMCA0' + Ca23, [k_PMCA0_leak]

    Ca24, + PMCA0' <-> PMCA1'      [>k_PMCA0_1, <k_PMCA1_0]
    PMCA0'       -> PMCA0' + Ca24, [k_PMCA0_leak]

    Ca25, + PMCA0' <-> PMCA1'      [>k_PMCA0_1, <k_PMCA1_0]
    PMCA0'       -> PMCA0' + Ca25, [k_PMCA0_leak]

    Ca26, + PMCA0' <-> PMCA1'      [>k_PMCA0_1, <k_PMCA1_0]
    PMCA0'       -> PMCA0' + Ca26, [k_PMCA0_leak]

    Ca27, + PMCA0' <-> PMCA1'      [>k_PMCA0_1, <k_PMCA1_0]
    PMCA0'       -> PMCA0' + Ca27, [k_PMCA0_leak]

    Ca28, + PMCA0' <-> PMCA1'      [>k_PMCA0_1, <k_PMCA1_0]
    PMCA0'       -> PMCA0' + Ca28, [k_PMCA0_leak]

    Ca29, + PMCA0' <-> PMCA1'      [>k_PMCA0_1, <k_PMCA1_0]
    PMCA0'       -> PMCA0' + Ca29, [k_PMCA0_leak]
}

INSTANTIATE PMCA OBJECT
{
	/* presynaptic PMCA */
	 presynaptic_PMCA RELEASE_SITE {
	    SHAPE = (MFB.bouton[ALL])
	    MOLECULE = PMCA0'
	    DENSITY = PMCA_density_presynaptic
	}
}