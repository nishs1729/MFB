    VDCC28_C3' <-> VDCC28_O'          [>k_VDCC_C34, <k_VDCC_C43]
    VDCC28_O'   -> VDCC28_O' + Ca28,  [k_VDCC_Ca]

    VDCC29_C0' <-> VDCC29_C1'         [>k_VDCC_C01, <k_VDCC_C10]
    VDCC29_C1' <-> VDCC29_C2'         [>k_VDCC_C12, <k_VDCC_C21]
    VDCC29_C2' <-> VDCC29_C3'         [>k_VDCC_C23, <k_VDCC_C32]
    VDCC29_C3' <-> VDCC29_O'          [>k_VDCC_C34, <k_VDCC_C43]
