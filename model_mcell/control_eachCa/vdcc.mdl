    VDCC30_C0' <-> VDCC30_C1'         [>k_VDCC_C01, <k_VDCC_C10]
    VDCC30_C1' <-> VDCC30_C2'         [>k_VDCC_C12, <k_VDCC_C21]
    VDCC30_C2' <-> VDCC30_C3'         [>k_VDCC_C23, <k_VDCC_C32]
    VDCC30_C3' <-> VDCC30_O'          [>k_VDCC_C34, <k_VDCC_C43]
    VDCC30_O'   -> VDCC30_O' + Ca30,  [k_VDCC_Ca]

    VDCC31_C0' <-> VDCC31_C1'         [>k_VDCC_C01, <k_VDCC_C10]
    VDCC31_C1' <-> VDCC31_C2'         [>k_VDCC_C12, <k_VDCC_C21]
    VDCC31_C2' <-> VDCC31_C3'         [>k_VDCC_C23, <k_VDCC_C32]
    VDCC31_C3' <-> VDCC31_O'          [>k_VDCC_C34, <k_VDCC_C43]
    VDCC31_O'   -> VDCC31_O' + Ca31,  [k_VDCC_Ca]

    VDCC32_C0' <-> VDCC32_C1'         [>k_VDCC_C01, <k_VDCC_C10]
    VDCC32_C1' <-> VDCC32_C2'         [>k_VDCC_C12, <k_VDCC_C21]
    VDCC32_C2' <-> VDCC32_C3'         [>k_VDCC_C23, <k_VDCC_C32]
    VDCC32_C3' <-> VDCC32_O'          [>k_VDCC_C34, <k_VDCC_C43]
    VDCC32_O'   -> VDCC32_O' + Ca32,  [k_VDCC_Ca]

    VDCC33_C0' <-> VDCC33_C1'         [>k_VDCC_C01, <k_VDCC_C10]
    VDCC33_C1' <-> VDCC33_C2'         [>k_VDCC_C12, <k_VDCC_C21]
    VDCC33_C2' <-> VDCC33_C3'         [>k_VDCC_C23, <k_VDCC_C32]
    VDCC33_C3' <-> VDCC33_O'          [>k_VDCC_C34, <k_VDCC_C43]
    VDCC33_O'   -> VDCC33_O' + Ca33,  [k_VDCC_Ca]

    VDCC34_C0' <-> VDCC34_C1'         [>k_VDCC_C01, <k_VDCC_C10]
    VDCC34_C1' <-> VDCC34_C2'         [>k_VDCC_C12, <k_VDCC_C21]
    VDCC34_C2' <-> VDCC34_C3'         [>k_VDCC_C23, <k_VDCC_C32]
    VDCC34_C3' <-> VDCC34_O'          [>k_VDCC_C34, <k_VDCC_C43]
    VDCC34_O'   -> VDCC34_O' + Ca34,  [k_VDCC_Ca]

    VDCC35_C0' <-> VDCC35_C1'         [>k_VDCC_C01, <k_VDCC_C10]
    VDCC35_C1' <-> VDCC35_C2'         [>k_VDCC_C12, <k_VDCC_C21]
    VDCC35_C2' <-> VDCC35_C3'         [>k_VDCC_C23, <k_VDCC_C32]
    VDCC35_C3' <-> VDCC35_O'          [>k_VDCC_C34, <k_VDCC_C43]
    VDCC35_O'   -> VDCC35_O' + Ca35,  [k_VDCC_Ca]

}

/* VDCC clusters */
vdcc_disk_file = "vdcc_disks/vdcc_disk_n" & nVDCC & "_d" & dVDCC & "_nAZ" & nAZ & ".mdl"
INCLUDE_FILE = vdcc_disk_file


INSTANTIATE VDCC OBJECT
{
    vdcc_disk OBJECT vdcc_disk {
        TRANSLATE = [0, 0, -0.400]
    }
}