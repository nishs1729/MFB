DEFINE_REACTIONS {
    /* P/Q-type Voltage Dependent Calcium Channels */
    /* From Bischoffberger et al., 2002, Neuroscience J.*/
    VDCC1_C0' <-> VDCC1_C1'         [>k_VDCC_C01, <k_VDCC_C10]
    VDCC1_C1' <-> VDCC1_C2'         [>k_VDCC_C12, <k_VDCC_C21]
    VDCC1_C2' <-> VDCC1_C3'         [>k_VDCC_C23, <k_VDCC_C32]
    VDCC1_C3' <-> VDCC1_O'          [>k_VDCC_C34, <k_VDCC_C43]
    VDCC1_O'   -> VDCC1_O' + Ca1,   [k_VDCC_Ca]

    VDCC2_C0' <-> VDCC2_C1'         [>k_VDCC_C01, <k_VDCC_C10]
    VDCC2_C1' <-> VDCC2_C2'         [>k_VDCC_C12, <k_VDCC_C21]
    VDCC2_C2' <-> VDCC2_C3'         [>k_VDCC_C23, <k_VDCC_C32]
    VDCC2_C3' <-> VDCC2_O'          [>k_VDCC_C34, <k_VDCC_C43]
    VDCC2_O'   -> VDCC2_O' + Ca2,   [k_VDCC_Ca]

