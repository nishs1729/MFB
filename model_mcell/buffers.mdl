//------- Calbindin Rates and Parameters ----------

D_cb = 0 //0.28e-6 // Schmidt et al. 2003, J. Physiol.
cb_conc = 40e-6

// calB reaction rates
cbH_on  = 0.55e7
cbH_off = 2.6
cbM_on  = 4.35e7
cbM_off = 35.8

// calbindin eq fractions at [cbH0M0]o = 45 uM and [Ca]i = ~100 nm
cbH0M0_feq = 0.542
cbH0M1_feq = 0.132
cbH1M0_feq = 0.229
cbH1M1_feq = 0.0557
cbH0M2_feq = 0.008
cbH2M0_feq = 0.0242
cbH1M2_feq = 0.00338
cbH2M1_feq = 0.00589
cbH2M2_feq = 0.000358

/*
// -------- CBP Rate Constants ---------
// All with Kd = 2 uM and Fast kinetics based on BAPTA association rate
fast_on    = 0.6e9
fast_off   = 1.2e3
M_on       = 0.6e8
M_off      = 1.2e2
slow_on    = 0.6e7
slow_off   = 1.2e1
v_slow_on  = 0.6e6
v_slow_off = 1.2


// ------ Calmodulin Rate Constants ---------
cam_for_1 = 6e6
cam_back_1 = 40
cam_for_2 = 9.5e6
cam_back_2 = 40
cam_for_3 = 8e6
cam_back_3 = 600
cam_for_4 = 4.3e7
cam_back_4 = 600
*/

DEFINE_MOLECULES {

    cbH0M0   {D_3D = D_cb CUSTOM_SPACE_STEP = 0.100 TARGET_ONLY}
    cbH0M1   {D_3D = D_cb CUSTOM_SPACE_STEP = 0.100 TARGET_ONLY}
    cbH0M2   {D_3D = D_cb CUSTOM_SPACE_STEP = 0.100 TARGET_ONLY}
    cbH1M0   {D_3D = D_cb CUSTOM_SPACE_STEP = 0.100 TARGET_ONLY}
    cbH1M1   {D_3D = D_cb CUSTOM_SPACE_STEP = 0.100 TARGET_ONLY}
    cbH1M2   {D_3D = D_cb CUSTOM_SPACE_STEP = 0.100 TARGET_ONLY}
    cbH2M0   {D_3D = D_cb CUSTOM_SPACE_STEP = 0.100 TARGET_ONLY}
    cbH2M1   {D_3D = D_cb CUSTOM_SPACE_STEP = 0.100 TARGET_ONLY}
    cbH2M2   {D_3D = D_cb CUSTOM_SPACE_STEP = 0.100 TARGET_ONLY}

    /*
    calmodulin.B0 {D_3D = D_calmodulin CUSTOM_SPACE_STEP = 0.020 TARGET_ONLY}
    calmodulin.B1 {D_3D = D_calmodulin CUSTOM_SPACE_STEP = 0.020 TARGET_ONLY}
    calmodulin.B2 {D_3D = D_calmodulin CUSTOM_SPACE_STEP = 0.020 TARGET_ONLY}
    calmodulin.B3 {D_3D = D_calmodulin CUSTOM_SPACE_STEP = 0.020 TARGET_ONLY}
    calmodulin.B4 {D_3D = D_calmodulin CUSTOM_SPACE_STEP = 0.020 TARGET_ONLY}

    fast_sp.U     {D_3D = D_cbp CUSTOM_SPACE_STEP = 0.020 TARGET_ONLY}
    fast_sp.B     {D_3D = D_cbp CUSTOM_SPACE_STEP = 0.020 TARGET_ONLY}
    M_sp.U        {D_3D = D_cbp CUSTOM_SPACE_STEP = 0.020 TARGET_ONLY}
    M_sp.B        {D_3D = D_cbp CUSTOM_SPACE_STEP = 0.020 TARGET_ONLY}
    slow_sp.U     {D_3D = D_cbp CUSTOM_SPACE_STEP = 0.020 TARGET_ONLY}
    slow_sp.B     {D_3D = D_cbp CUSTOM_SPACE_STEP = 0.020 TARGET_ONLY}
    v_slow_sp.U   {D_3D = D_cbp CUSTOM_SPACE_STEP = 0.020 TARGET_ONLY}
    v_slow_sp.B   {D_3D = D_cbp CUSTOM_SPACE_STEP = 0.020 TARGET_ONLY}
    */

}

DEFINE_REACTIONS {

    /* -------- Calcium Binding Protein Calbindin ------ */
    cbH0M0 + Ca -> cbH1M0      [2*cbH_on]
    cbH1M0      -> cbH0M0 + Ca [cbH_off]
    cbH1M0 + Ca -> cbH2M0      [cbH_on]
    cbH2M0      -> cbH1M0 + Ca [2*cbH_off]
    cbH0M1 + Ca -> cbH1M1      [2*cbH_on]
    cbH1M1      -> cbH0M1 + Ca [cbH_off]
    cbH1M1 + Ca -> cbH2M1      [cbH_on]
    cbH2M1      -> cbH1M1 + Ca [2*cbH_off]
    cbH0M2 + Ca -> cbH1M2      [2*cbH_on]
    cbH1M2      -> cbH0M2 + Ca [cbH_off]
    cbH1M2 + Ca -> cbH2M2      [cbH_on]
    cbH2M2      -> cbH1M2 + Ca [2*cbH_off]

    cbH0M0 + Ca -> cbH0M1      [2*cbM_on]
    cbH0M1      -> cbH0M0 + Ca [cbM_off]
    cbH0M1 + Ca -> cbH0M2      [cbM_on]
    cbH0M2      -> cbH0M1 + Ca [2*cbM_off]
    cbH1M0 + Ca -> cbH1M1      [2*cbM_on]
    cbH1M1      -> cbH1M0 + Ca [cbM_off]
    cbH1M1 + Ca -> cbH1M2      [cbM_on]
    cbH1M2      -> cbH1M1 + Ca [2*cbM_off]
    cbH2M0 + Ca -> cbH2M1      [2*cbM_on]
    cbH2M1      -> cbH2M0 + Ca [cbM_off]
    cbH2M1 + Ca -> cbH2M2      [cbM_on]
    cbH2M2      -> cbH2M1 + Ca [2*cbM_off]


    /*/ --------- CBPs; fast, M, slow & v_slow --------
    fast_sp.U + Ca -> fast_sp.B      [fast_on]
    fast_sp.B      -> fast_sp.U + Ca [fast_off]

    M_sp.U + Ca -> M_sp.B      [M_on]
    M_sp.B      -> M_sp.U + Ca [M_off]

    slow_sp.U + Ca -> slow_sp.B      [slow_on]
    slow_sp.B      -> slow_sp.U + Ca [slow_off]

    v_slow_sp.U + Ca -> v_slow_sp.B      [v_slow_on]
    v_slow_sp.B      -> v_slow_sp.U + Ca [v_slow_off]
    */

    /*/ ------- Define Calmodulin Reaction -------
    calmodulin.B0 + Ca -> calmodulin.B1      [cam_for_1]
    calmodulin.B1      -> calmodulin.B0 + Ca [cam_back_1]
    calmodulin.B1 + Ca -> calmodulin.B2      [cam_for_2]
    calmodulin.B2      -> calmodulin.B1 + Ca [cam_back_2]
    calmodulin.B2 + Ca -> calmodulin.B3      [cam_for_3]
    calmodulin.B3      -> calmodulin.B2 + Ca [cam_back_3]
    calmodulin.B3 + Ca -> calmodulin.B4      [cam_for_4]
    calmodulin.B4      -> calmodulin.B3 + Ca [cam_back_4]
    */

}

INSTANTIATE CB OBJECT
{
    /* presynaptic calbindin initial equilibrium conditions: */
    presynaptic_cb_1 RELEASE_SITE {
        SHAPE = (MFB.bouton[ALL])
        MOLECULE = cbH0M0
        CONCENTRATION = cbH0M0_feq*cb_conc
    }
    presynaptic_cb_2 RELEASE_SITE {
        SHAPE = (MFB.bouton[ALL])
        MOLECULE = cbH0M1
        CONCENTRATION = cbH0M1_feq*cb_conc
    }
    presynaptic_cb_3 RELEASE_SITE {
        SHAPE = (MFB.bouton[ALL])
        MOLECULE = cbH1M0
        CONCENTRATION = cbH1M0_feq*cb_conc
    }
    presynaptic_cb_4 RELEASE_SITE {
        SHAPE = (MFB.bouton[ALL])
        MOLECULE = cbH1M1
        CONCENTRATION = cbH1M1_feq*cb_conc
    }
    presynaptic_cb_5 RELEASE_SITE {
        SHAPE = (MFB.bouton[ALL])
        MOLECULE = cbH0M2
        CONCENTRATION = cbH0M2_feq*cb_conc
    }
    presynaptic_cb_6 RELEASE_SITE {
        SHAPE = (MFB.bouton[ALL])
        MOLECULE = cbH2M0
        CONCENTRATION = cbH2M0_feq*cb_conc
    }
    presynaptic_cb_7 RELEASE_SITE {
        SHAPE = (MFB.bouton[ALL])
        MOLECULE = cbH1M2
        CONCENTRATION = cbH1M2_feq*cb_conc
    }
    presynaptic_cb_8 RELEASE_SITE {
        SHAPE = (MFB.bouton[ALL])
        MOLECULE = cbH2M1
        CONCENTRATION = cbH2M2_feq*cb_conc
    }
    presynaptic_cb_9 RELEASE_SITE {
        SHAPE = (MFB.bouton[ALL])
        MOLECULE = cbH2M2
        CONCENTRATION = cbH2M2_feq*cb_conc
    }
}