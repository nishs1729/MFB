
k_reltrig_pre_reset = 158  /* 6.33ms reset Dobrunz & Stevens, 1997, PNAS */
k_reltrig_pre_redock = 1/2.8
k_reltrig_sudhof_f = (0.4*1.53e8)
k_reltrig_sudhof_b = (0.4*5.8e3)
k_reltrig_sudhof_af = (1.3*2.94e6)
k_reltrig_sudhof_ab = (0.5*130/5)
b_sudhof = 0.25

fusion_rate_sync_sudhof = 6000
fusion_rate_async_sudhof = 50
fusion_rate_sync_facilitated_sudhof = fusion_rate_sync_sudhof * fusion_rate_async_sudhof
fusion_rate_sudhof_spont = 0.417e-3

INCLUDE_FILE = "az_mol_" & RRP & ".mdl"
INCLUDE_FILE = "az_rxn.mdl"

x0   = 0.0  //um
y0   = 0.0  //um
xs   = 0.25 //um
az_x = 0.50 //um
az_y = 0.40 //um

INSTANTIATE AZ OBJECT {
    presynaptic_active_zone RELEASE_SITE {
        SHAPE = LIST
        MOLECULE_POSITIONS {
            az_sudhof' [x0,           y0,        -0.4]    //1
            az_sudhof' [x0-az_x,      y0,        -0.4] 		//2
            az_sudhof' [x0+az_x,      y0,        -0.4] 		//3
            az_sudhof' [x0-xs,        y0+az_y,   -0.4] 	  //4
            az_sudhof' [x0+xs,        y0-az_y,   -0.4] 	  //5
            az_sudhof' [x0-xs,        y0-az_y,   -0.4] 		//6
            az_sudhof' [x0+xs,        y0+az_y,   -0.4] 		//7
            az_sudhof' [x0-2*az_x,    y0,        -0.4] 	  //8
            az_sudhof' [x0+2*az_x,    y0,        -0.4] 	  //9
            az_sudhof' [x0-az_x-xs,   y0+az_y,   -0.4]   	//10
            az_sudhof' [x0+az_x+xs,   y0-az_y,   -0.4] 		//11
            az_sudhof' [x0+az_x+xs,   y0+az_y,   -0.4] 	  //12
            az_sudhof' [x0-az_x-xs,   y0-az_y,   -0.4] 		//13
            az_sudhof' [x0,           y0+2*az_y, -0.4] 	  //14
            az_sudhof' [x0,           y0-2*az_y, -0.4] 		//15
            az_sudhof' [x0-az_x,      y0+1.999*az_y, -0.4]  //16
            az_sudhof' [x0+az_x,      y0-2*az_y, -0.4] 		//17
            az_sudhof' [x0-az_x,      y0-2*az_y, -0.4] 		//18
            az_sudhof' [x0+az_x,      y0+2*az_y, -0.4] 	  //19
            az_sudhof' [x0-3*az_x,    y0,        -0.4]	  //20
        }
        SITE_DIAMETER = 0.02
    }
}

// Synchronous Release Sites
synchronous_release_sites OBJECT {
  synchronous_release_site_0 RELEASE_SITE {
    SHAPE = SPHERICAL
    LOCATION = [0,0,1e-3]
    MOLECULE = Glu
    SITE_DIAMETER = 0
    NUMBER_TO_RELEASE = n_Glu_neuron
    RELEASE_PATTERN = synchronous_release_0
  }
  synchronous_release_site_1 RELEASE_SITE {
    SHAPE = SPHERICAL
    LOCATION = [0,0,1e-3]
    MOLECULE = Glu
    SITE_DIAMETER = 0
    NUMBER_TO_RELEASE = n_Glu_neuron
    RELEASE_PATTERN = synchronous_release_1
  }
  synchronous_release_site_2 RELEASE_SITE {
    SHAPE = SPHERICAL
    LOCATION = [0,0,1e-3]
    MOLECULE = Glu
    SITE_DIAMETER = 0
    NUMBER_TO_RELEASE = n_Glu_neuron
    RELEASE_PATTERN = synchronous_release_2
  }
}

// Asynchronous Release Sites
asynchronous_release_sites OBJECT {
  asynchronous_release_site_0 RELEASE_SITE {
    SHAPE = SPHERICAL
    LOCATION = [0,0,1e-3]
    MOLECULE = Glu
    SITE_DIAMETER = 0
    NUMBER_TO_RELEASE = n_Glu_neuron
    RELEASE_PATTERN = asynchronous_release_0
  }
  asynchronous_release_site_1 RELEASE_SITE {
    SHAPE = SPHERICAL
    LOCATION = [0,0,1e-3]
    MOLECULE = Glu
    SITE_DIAMETER = 0
    NUMBER_TO_RELEASE = n_Glu_neuron
    RELEASE_PATTERN = asynchronous_release_1
  }
  asynchronous_release_site_2 RELEASE_SITE {
    SHAPE = SPHERICAL
    LOCATION = [0,0,1e-3]
    MOLECULE = Glu
    SITE_DIAMETER = 0
    NUMBER_TO_RELEASE = n_Glu_neuron
    RELEASE_PATTERN = asynchronous_release_2
  }
  asynchronous_release_site_3 RELEASE_SITE {
    SHAPE = SPHERICAL
    LOCATION = [0,0,1e-3]
    MOLECULE = Glu
    SITE_DIAMETER = 0
    NUMBER_TO_RELEASE = n_Glu_neuron
    RELEASE_PATTERN = asynchronous_release_3
  }
  asynchronous_release_site_4 RELEASE_SITE {
    SHAPE = SPHERICAL
    LOCATION = [0,0,1e-3]
    MOLECULE = Glu
    SITE_DIAMETER = 0
    NUMBER_TO_RELEASE = n_Glu_neuron
    RELEASE_PATTERN = asynchronous_release_4
  }
}

spontaneous_release_site RELEASE_SITE {
  SHAPE = SPHERICAL
  LOCATION = [0,0,1e-3]
  MOLECULE = Glu
  SITE_DIAMETER = 0
  NUMBER_TO_RELEASE = n_Glu_neuron
  RELEASE_PATTERN = spontaneous_release
}

INSTANTIATE AZ_release_sites OBJECT
{
    synchronous_release_sites OBJECT synchronous_release_sites {}
    asynchronous_release_sites OBJECT asynchronous_release_sites {}
    spontaneous_release_site OBJECT spontaneous_release_site {}
}